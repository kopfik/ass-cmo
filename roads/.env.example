# ass-roads configuration. Copy to roads/.env and fill in.
# roads/.env is gitignored; never commit it.

# Must match POSTGRES_DB of the ASS-CMO stack.
POSTGRES_DB=inventory_db

# Read-only role created by database/scripts/003_roads_readonly_user.sql.
# It can read only the roads_hosts view.
ROADS_DB_USER=ass_roads
ROADS_DB_PASSWORD=

# Public hostname and URL of the ass-roads page.
# The handler install commands shown on the page download from ROADS_BASE_URL.
ROADS_INSTANCE_NAME=ass-roads.example.com
ROADS_BASE_URL=https://ass-roads.example.com

# Open web links through the assweb:// handler instead of a new browser tab.
ROADS_ASSWEB_PROTOCOL=false
